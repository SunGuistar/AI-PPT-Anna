{
  "schema": 2,
  "host_capabilities": ["aps.files"],
  "required_executas": [
    {
      "tool_id": "bundled:focus-flow",
      "version": "latest"
    }
  ],
  "tags": ["focus-flow"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "focus-flow",
        "default": true,
        "default_size": { "w": 480, "h": 360 },
        "min_size": { "w": 320, "h": 240 }
      }
    ],
    "host_api": {
      "tools": ["required:*"],
      "storage": ["get", "set"],
      "files": ["download"],
      "llm": ["complete"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
